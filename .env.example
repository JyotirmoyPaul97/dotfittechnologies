# Supabase Configuration
# Copy this file to .env.local and fill in your values from the Supabase dashboard:
# https://app.supabase.com/project/_/settings

# Public environment variables (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side environment variables (kept secret)
# Required for server-side auth operations (e.g., session validation)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here